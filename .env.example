# PhysioGraph 1.5 lightweight and public demonstration configuration.
PHYSIOGRAPH_INFERENCE_BACKEND=numpy
PHYSIOGRAPH_PUBLIC_MODE=1
PHYSIOGRAPH_AUTO_DEMO=1
PHYSIOGRAPH_AUTO_DEMO_SPEED=10
# Optional: exact frontend origins, separated by commas. Wildcard * is blocked.
# PHYSIOGRAPH_CORS_ORIGINS=https://my-frontend.onrender.com
# Optional SERVER-ONLY ingest secret for a trusted external producer.
# PHYSIOGRAPH_INGEST_API_KEY=REPLACE_WITH_A_LONG_UNGUESSABLE_SECRET
